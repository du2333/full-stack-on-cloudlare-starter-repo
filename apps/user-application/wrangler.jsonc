/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/auth/*",
      "/trpc/*",
      "/click-socket"
    ]
  },
  "observability": {
    "enabled": true,
  },
  "keep_vars": true,
  "env": {
    "stage": {
      "vars": {
        "STRIPE_PRODUCT_BASIC": "price_1RJ0EECVQlUXpoth61dFfdvs",
        "STRIPE_PRODUCT_PRO": "price_1RJ0EkCVQlUXpoth0Xym3Pib",
        "STRIPE_PRODUCT_ENTERPRICE": "price_1SK8B1CVQlUXpothj4bS4C9m"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "0855e5ae-a31b-4bee-b180-119d0bc2a8a8",
          "remote": true
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "remote": true
        }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "aff4afca-92f9-4568-81c1-8ef78c708501",
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production",
        }
      ]
    }
  }
}